[
  {
    "name": "in sync: nothing to report",
    "baseline": {"fn-complexity": {"src/a.py#parse": 41}, "dead-file": {"src/b.py": 1}},
    "current": {"fn-complexity": {"src/a.py#parse": 41}, "dead-file": {"src/b.py": 1}},
    "expect": {}
  },
  {
    "name": "no baseline: every finding is new",
    "baseline": {},
    "current": {"dead-file": {"src/b.py": 1}},
    "expect": {"new": ["dead-file:src/b.py"]}
  },
  {
    "name": "same key under another rule is new",
    "baseline": {"r": {"a": 1}},
    "current": {"other": {"a": 1}},
    "expect": {"new": ["other:a"], "stale": ["r:a"]}
  },
  {
    "name": "ratchet: count up is worse",
    "baseline": {"r": {"a": 3}},
    "current": {"r": {"a": 5}},
    "expect": {"worse": ["r:a"]}
  },
  {
    "name": "ratchet: count down is stale (baseline must be tightened)",
    "baseline": {"r": {"a": 3}},
    "current": {"r": {"a": 2}},
    "expect": {"stale": ["r:a"]}
  },
  {
    "name": "ratchet: fixed entry is stale",
    "baseline": {"r": {"a": 1}},
    "current": {},
    "expect": {"stale": ["r:a"]}
  },
  {
    "name": "renamed file: baseline keys follow the rename",
    "baseline": {"fn-complexity": {"src/old.py#parse": 30}},
    "current": {"fn-complexity": {"src/new.py#parse": 30}},
    "renames": {"src/old.py": "src/new.py"},
    "expect": {"moved": ["fn-complexity:src/new.py#parse"]}
  },
  {
    "name": "rename does not rewrite a longer path that merely starts the same",
    "baseline": {"r": {"src/a.js": 1, "src/a.jsx": 1}},
    "current": {"r": {"src/b.js": 1, "src/a.jsx": 1}},
    "renames": {"src/a.js": "src/b.js"},
    "expect": {"moved": ["r:src/b.js"]}
  },
  {
    "name": "symbol moved to another file without getting worse is a move",
    "baseline": {"fn-complexity": {"src/a.py#parse": 30}},
    "current": {"fn-complexity": {"src/b.py#parse": 28}},
    "expect": {"moved": ["fn-complexity:src/b.py#parse"], "stale": ["fn-complexity:src/b.py#parse"]}
  },
  {
    "name": "symbol moved and got worse is not a move",
    "baseline": {"fn-complexity": {"src/a.py#parse": 30}},
    "current": {"fn-complexity": {"src/b.py#parse": 35}},
    "expect": {"new": ["fn-complexity:src/b.py#parse"], "stale": ["fn-complexity:src/a.py#parse"]}
  },
  {
    "name": "symbol split into two files is not a move",
    "baseline": {"fn-complexity": {"src/a.py#parse": 30}},
    "current": {"fn-complexity": {"src/b.py#parse": 25, "src/c.py#parse": 25}},
    "expect": {"new": ["fn-complexity:src/b.py#parse", "fn-complexity:src/c.py#parse"], "stale": ["fn-complexity:src/a.py#parse"]}
  },
  {
    "name": "budget: growth within tolerance passes",
    "meta": {"file-size": {"mode": "budget", "growth": {"pct": 10, "abs": 50}}},
    "baseline": {"file-size": {"src/a.py": 1000}},
    "current": {"file-size": {"src/a.py": 1090}},
    "expect": {"within": ["file-size:src/a.py"]}
  },
  {
    "name": "budget: growth beyond both limits is worse",
    "meta": {"file-size": {"mode": "budget", "growth": {"pct": 10, "abs": 50}}},
    "baseline": {"file-size": {"src/a.py": 1000}},
    "current": {"file-size": {"src/a.py": 1101}},
    "expect": {"worse": ["file-size:src/a.py"]}
  },
  {
    "name": "budget: small file may grow by the absolute allowance",
    "meta": {"file-size": {"mode": "budget", "growth": {"pct": 10, "abs": 50}}},
    "baseline": {"file-size": {"src/a.py": 100}},
    "current": {"file-size": {"src/a.py": 150}},
    "expect": {"within": ["file-size:src/a.py"]}
  },
  {
    "name": "budget: decrease is slack, not a failure",
    "meta": {"file-size": {"mode": "budget", "growth": {"pct": 10, "abs": 50}}},
    "baseline": {"file-size": {"src/a.py": 1000}},
    "current": {"file-size": {"src/a.py": 900}},
    "expect": {"slack": ["file-size:src/a.py"]}
  },
  {
    "name": "budget: new key is new",
    "meta": {"file-size": {"mode": "budget", "growth": {"pct": 10, "abs": 50}}},
    "baseline": {},
    "current": {"file-size": {"src/a.py": 700}},
    "expect": {"new": ["file-size:src/a.py"]}
  },
  {
    "name": "budget higher-is-better: drop beyond tolerance is worse",
    "meta": {"metric": {"mode": "budget", "direction": "higher", "growth": {"abs": 0.5}}},
    "baseline": {"metric": {"coverage": 81.0}},
    "current": {"metric": {"coverage": 80.2}},
    "expect": {"worse": ["metric:coverage"]}
  },
  {
    "name": "budget higher-is-better: small drop is within budget, gain is slack",
    "meta": {"metric": {"mode": "budget", "direction": "higher", "growth": {"abs": 0.5}}, "m2": {"mode": "budget", "direction": "higher", "growth": {"abs": 0.5}}},
    "baseline": {"metric": {"coverage": 81.0}, "m2": {"x": 10}},
    "current": {"metric": {"coverage": 80.7}, "m2": {"x": 12}},
    "expect": {"within": ["metric:coverage"], "slack": ["m2:x"]}
  },
  {
    "name": "keep: removed test is lost, skipped test is lost from active, new test is unrecorded",
    "meta": {"present": {"mode": "keep"}, "active": {"mode": "keep"}},
    "baseline": {"present": {"t::a": 1, "t::b": 1}, "active": {"t::a": 1, "t::b": 1}},
    "current": {"present": {"t::b": 1, "t::c": 1}, "active": {"t::c": 1}},
    "expect": {"lost": ["active:t::a", "active:t::b", "present:t::a"], "unrecorded": ["active:t::c", "present:t::c"]}
  },
  {
    "name": "keep entries are never paired as moves",
    "meta": {"surface": {"mode": "keep"}},
    "baseline": {"surface": {"pkg.a#f(x)": 1}},
    "current": {"surface": {"pkg.b#f(x)": 1}},
    "expect": {"lost": ["surface:pkg.a#f(x)"], "unrecorded": ["surface:pkg.b#f(x)"]}
  },
  {
    "name": "update: tighten lowers and drops, never adds or raises",
    "baseline": {"r": {"lower": 5, "gone": 2, "worse": 3}},
    "current": {"r": {"lower": 4, "worse": 9, "new": 1}},
    "expect_update": {"r": {"lower": 4, "worse": 3}}
  },
  {
    "name": "update: budget growth within tolerance is not written back",
    "meta": {"file-size": {"mode": "budget", "growth": {"pct": 10, "abs": 50}}},
    "baseline": {"file-size": {"a": 1000, "b": 1000}},
    "current": {"file-size": {"a": 1050, "b": 800}},
    "expect_update": {"file-size": {"a": 1000, "b": 800}}
  },
  {
    "name": "update: renames and moves are rewritten",
    "baseline": {"r": {"old.py#f": 30, "x.py#g": 25}},
    "current": {"r": {"new.py#f": 30, "y.py#g": 22}},
    "renames": {"old.py": "new.py"},
    "expect_update": {"r": {"new.py#f": 30, "y.py#g": 22}}
  },
  {
    "name": "update: keep records new entries, drops lost ones only with an exception",
    "meta": {"present": {"mode": "keep"}},
    "baseline": {"present": {"t::a": 1, "t::b": 1}},
    "current": {"present": {"t::c": 1}},
    "excepted": ["present:t::a"],
    "expect_update": {"present": {"t::b": 1, "t::c": 1}}
  },
  {
    "name": "update: higher-is-better metric rises with improvements, never falls",
    "meta": {"metric": {"mode": "budget", "direction": "higher", "growth": {"abs": 0.5}}},
    "baseline": {"metric": {"up": 80.0, "down": 80.0}},
    "current": {"metric": {"up": 82.5, "down": 79.8}},
    "expect_update": {"metric": {"up": 82.5, "down": 80.0}}
  }
]
